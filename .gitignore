# Скомпилированный бинарник (имя совпадает с именем модуля)
/users

# Локальные переменные окружения — Фактор 3: конфиг не хранится в репозитории
.env
.env.*
# ...НО .env.example — исключение: это документация контракта с окружением,
# а не конфигурация. Без явного «!» правило .env.* съедает и его,
# и новый разработчик не узнает, какие переменные вообще нужны сервису.
# Порядок правил важен: отрицание обязано идти ПОСЛЕ исключающего шаблона.
!.env.example

# Артефакты редакторов
.idea/
.vscode/
