# Пример локального окружения. Копируется в .env, который в .gitignore.
#
# Зачем .env.example коммитить, а .env — нет:
# .env.example — это ДОКУМЕНТАЦИЯ контракта с окружением. Он отвечает
# на вопрос «какие переменные вообще нужны сервису», который иначе
# выясняется чтением всего кода. Значения в нём заведомо не секретные.
#
# Фактор 3 в связке с Фактором 10: список переменных одинаков локально
# и в проде, различаются только значения.

# --- backing service ---
POSTGRES_DB=moodbot
POSTGRES_USER=moodbot
POSTGRES_PASSWORD=devpassword

# --- приложение ---
# DATABASE_URL в compose собирается из переменных выше.
# При запуске без compose (go run .) задайте её целиком:
# DATABASE_URL=postgres://moodbot:devpassword@localhost:15432/moodbot?sslmode=disable

SERVER_PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=text
DB_MAX_CONNS=5
SHUTDOWN_TIMEOUT=15s
